# توكن البوت من @BotFather (مطلوب)
BOT_TOKEN=

# الدومين العام من Railway (مطلوب) — مثال: https://search-bot-production.up.railway.app
# بدون / في النهاية
BASE_PUBLIC_URL=

# المنفذ (اختياري — Railway يمرّر PORT تلقائيًا، الافتراضي 8080)
PORT=8080

# سر توقيع روابط المشاهدة (اختياري — الافتراضي: قيمة BOT_TOKEN)
WATCH_SECRET=

# بيانات API من my.telegram.org ← API development tools (اختياري — الاثنان معًا)
# تفعيلها يشغّل سيرفر Bot API محلي داخل الحاوية فيرتفع حد إرسال الفيديو من 50MB إلى 2GB
TG_API_ID=
TG_API_HASH=

# معرفات تليجرام للأدمن مفصولة بفواصل (اختياري — يفعّل /stats /ban /unban /broadcast)
ADMIN_IDS=

# قناة الاشتراك الإجباري: @channel أو معرف -100... (اختياري — فارغ = معطّل)
# ⚠️ يجب أن يكون البوت أدمن في القناة حتى يتمكن من التحقق من العضوية
FORCE_SUB_CHANNEL=

# مجلد تخزين البيانات (المفضلة/المتابعات/المستخدمين) — الافتراضي: مجلد temp
# ⚠️ على Railway التخزين مؤقت وتُفقد البيانات عند إعادة النشر الكاملة
DATA_DIR=

# عدد الساعات بين كل فحص للحلقات الجديدة (المتابعات) — الافتراضي 6، أدنى 1
FOLLOW_CHECK_HOURS=6

# أقصى عدد حلقات في دفعة تحميل موسم واحدة — الافتراضي 24
BATCH_MAX_EPS=24

# أقصى عدد دفعات مواسم تعمل في نفس الوقت (لكل المستخدمين) — الافتراضي 2
BATCH_GLOBAL_MAX=2

# أقصى عدد محاولات إرسال فيديو الحلقة عند تقييد سرعة تليجرام (retry after) — الافتراضي 3
SEND_MAX_ATTEMPTS=3
